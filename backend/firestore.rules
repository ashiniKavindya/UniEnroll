rules_version = '3';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
             get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin';
    }
    
    // Helper function to check if user is the owner (for user documents)
    function isOwner() {
      return request.auth.token.email == resource.data.email;
    }
    
    // Allow admins full access to all collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Users collection
    match /users/{document=**} {
      // Users can see their own profile
      allow read: if isAuthenticated() && isOwner();
      // Only admins can write
      allow write: if isAdmin();
    }
    
    // Students collection
    match /students/{document=**} {
      // Students can read their own enrollment
      allow read: if isAuthenticated() && request.auth.token.email == resource.data.userEmail;
      // Lecturers and admins can read all students
      allow read: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role in ['lecturer', 'admin'];
      // Only admins can write
      allow write: if isAdmin();
    }
    
    // Lecturers collection
    match /lecturers/{document=**} {
      // Lecturers can read their own profile
      allow read: if isAuthenticated() && request.auth.token.email == resource.data.email;
      // All lecturers can list other lecturers
      allow read: if isAuthenticated();
      // Only admins can write
      allow write: if isAdmin();
    }
    
    // Faculties collection (readable by all authenticated users)
    match /faculties/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Departments collection (readable by all authenticated users)
    match /departments/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Courses collection (readable by all authenticated users)
    match /courses/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Modules collection (readable by all authenticated users)
    match /modules/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Enrollments collection
    match /enrollments/{document=**} {
      // Students can see their own enrollments
      allow read: if isAuthenticated() && request.auth.token.email == resource.data.studentEmail;
      // Lecturers can see enrollments for their modules
      allow read: if isAuthenticated();
      // Only admins can write
      allow write: if isAdmin();
    }
    
    // Admins collection
    match /admins/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
